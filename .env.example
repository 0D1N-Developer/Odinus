# Obtain this value from the Discord Developer Portal.
DISCORD_TOKEN=

# Puente con el plugin Odin-Discord de Minecraft.
# El token debe ser igual a bridge.token en plugins/Odin-Discord/config.yml.
# Vacio = la integracion con Minecraft queda desactivada.
MINECRAFT_BRIDGE_HOST=127.0.0.1
MINECRAFT_BRIDGE_PORT=8765
MINECRAFT_BRIDGE_TOKEN=
